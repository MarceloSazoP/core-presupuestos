# Copiar a .env.local y completar. .env.local no se versiona.

# Prototipo web (datos en un JSON local; ver README).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
DEV_CLIENT_NAME=Cliente de pruebas
DEV_CLIENT_EMAIL=
DEV_CLIENT_PHONE=+56900000000
# Dueño del presupuesto (usuario de la app móvil); en producción sale de su perfil.
DEV_PRO_NAME=Profesional de prueba
DEV_PRO_PHONE=+56 9 0000 0000
DEV_PRO_EMAIL=profesional@example.com

# Correo por SMTP (Gmail exige contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Para cuando exista la API (Fase 1 del backend).
API_BASE_URL=http://localhost:3001/api/v1
