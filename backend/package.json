{
  "name": "corepresupuesto-backend",
  "version": "0.0.0",
  "private": true,
  "description": "API de CorePresupuesto",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "sweep-files": "tsx --env-file=.env scripts/sweep-files.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "tsx --env-file=.env --import ./test/setup.ts --test-concurrency=1 --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
