# Copiar a .env y completar. .env no se versiona.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/core-prespuestos
TEST_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/core-prespuestos-test
WEB_BASE_URL=http://localhost:3012
# Pepper del HMAC del código de verificación: 32 bytes aleatorios en hex (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_CODE_PEPPER=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
SMS_DAILY_CAP=200
# Solo desarrollo: escribe el código de verificación en el log en vez de enviarlo. Prohibido en producción.
OTP_LOG_CODES=true
# Producción: obligatorias
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
