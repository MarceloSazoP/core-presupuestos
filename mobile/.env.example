# API. Sin esta variable, en desarrollo la app usa sola el computador que sirve Metro (puerto 3013), en cualquier red.
# Fijarla solo para apuntar a otra API, por ejemplo la publicada (en .env.local, que no se versiona).
# EXPO_PUBLIC_API_URL=https://core-presupuestos-backend.vercel.app/api/v1

# Build
EXPO_PUBLIC_APP_NAME=CorePresupuesto
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development
EXPO_PUBLIC_DEV_MODE=true
