{
  "expo": {
    "name": "CorePresupuesto",
    "slug": "balam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corepresupuesto",
    "userInterfaceStyle": "automatic",
    "description": "Captura información, prepara presupuestos y haz seguimiento",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corepresupuesto.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para registrar dónde se tomaron las fotos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.corepresupuesto.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos la cámara para leer el QR de la web y abrir tu presupuesto en el computador."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para agregarlas al presupuesto.",
          "cameraPermission": "Necesitamos la cámara para fotografiar lo que ves en la visita."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Necesitamos el micrófono para grabar notas de voz de la visita."
        }
      ],
      "expo-asset",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "CorePresupuesto usa tus contactos solo para traer los datos de un cliente que tú elijas."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f9d4072-2064-4cf9-8bca-0489b7acd819"
      }
    },
    "owner": "balamchacs-team"
  }
}
